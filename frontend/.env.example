# Frontend build settings (Vite). Only VITE_* values are included in the build,
# and they are PUBLIC: never put passwords, SMTP settings or secrets here.
#
# Hosted on Vercel: set this in Project → Settings → Environment Variables.
# Local development: leave it unset; the Vite dev server proxies /api to the
# backend on 127.0.0.1:4000.
VITE_API_BASE_URL=https://api.zodiacpatent.com
